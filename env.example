# 复制为 .env 后按需修改；进程环境变量优先于 .env

# ---- 后端 ----
LLM_BACKEND=openrouter                    # openrouter | gemma | mock；每个后端只读自己前缀的变量

# ---- OpenRouter（LLM_BACKEND=openrouter）----
OPENROUTER_MODEL=cheapest                 # cheapest = 启动时自动挑能用的最便宜模型；cheapest-free 含免费档；或写死 id
# OPENROUTER_API_KEY=                     # 不填就读 OPENROUTER_API_KEY_FILE
OPENROUTER_API_KEY_FILE=~/.openrouter_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=120
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_STRUCTURED=json_schema       # 不支持时自动降级 json_object → off
# OPENROUTER_REASONING_EFFORT=none        # 默认关推理；空 = 不发这个参数
# OPENROUTER_CHEAPEST_VENDORS=deepseek,qwen   # cheapest 只在这些厂商里挑；* = 不限
# MODEL_REVIEW=cheapest                  # 按任务分流：MODEL_<TASK>，TASK ∈ npc options summary review compress director branch scene

# ---- 自建 vLLM 上的 Gemma（LLM_BACKEND=gemma）----
GEMMA_BASE_URL=http://127.0.0.1:8000/v1   # agentrt/scripts/up51.sh 会把 51 的 vLLM 隧道到这里
GEMMA_MODEL=heretic                       # vLLM --served-model-name
# GEMMA_API_KEY=                          # 不填就读 GEMMA_API_KEY_FILE
GEMMA_API_KEY_FILE=~/.agentrt/api_key
GEMMA_TIMEOUT=120
GEMMA_MAX_RETRIES=3
GEMMA_MAX_CONTEXT_TOKENS=32768            # 与 vLLM --max-model-len 一致

# ---- Gemma 适配 ----
GEMMA_STRUCTURED=json_schema              # json_schema | json_object | off（服务端不支持会自动降级）
GEMMA_JSON_REPAIR_ATTEMPTS=2              # JSON 不合法时回填错误让模型重写的次数
GEMMA_MERGE_SYSTEM=false                  # 模板不认 system 角色时设 true
GEMMA_STRIP_THINKING=true
# GEMMA_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}

# ---- 各任务采样参数 ----
NPC_TEMPERATURE=0.8
NPC_MAX_TOKENS=700
OPTION_TEMPERATURE=0.9
OPTION_MAX_TOKENS=700
SUMMARY_TEMPERATURE=0.3
SUMMARY_MAX_TOKENS=700

# ---- 游戏 ----
PLAYER_NAME=旅行者
MAX_TURNS_PER_SESSION=20
HISTORY_TURNS=8                           # 工作记忆窗口（原文保留轮数），超出的压缩成摘要
MEMORY_TOP_K=3                            # 自动注入的往事条数，更多靠 recall_memory
OPTIONS_MODE=llm                          # llm | static
GAME_DEBUG=false
# GAME_SEED=42

# ---- 新增任务的采样参数 ----
REVIEW_TEMPERATURE=0.1
REVIEW_MAX_TOKENS=500
COMPRESS_TEMPERATURE=0.2
COMPRESS_MAX_TOKENS=400

# ---- 模型路由（可选）：把某个任务路由到同一 vLLM 下的另一个 served model ----
# MODEL_REVIEW=gemma-small
# MODEL_OPTIONS=gemma-small
# MODEL_COMPRESS=gemma-small

# ---- Loop：NPC 单轮 ReAct 循环的闸 ----
LOOP_MAX_STEPS=4                          # 最多几步（含最终 respond）
LOOP_MAX_REPEAT=1                         # 同参数重复调用超过几次就收紧为只能 respond
TURN_TOKEN_BUDGET=40000                   # 单轮 NPC 循环的 token 上限（防失控闸）
TURN_TIMEOUT_S=90                         # 单轮墙钟上限
OBS_MAX_CHARS=1000                        # 工具观察截断

# ---- 终止判断与收敛 ----
REVIEWER_MODE=llm                         # llm | rules | off（消融用）
REVIEW_FAIL_POLICY=reject                 # 审核调用失败时 reject(fail-closed) | accept
STALL_LIMIT=6                             # 连续几轮无进展就收束本次见面

# ---- 预算 ----
GAME_TOKEN_BUDGET=1500000                 # 整局 token 上限，0 = 不限
DEGRADE_RATIO=0.15                        # 剩余低于该比例时降级

# ---- 上下文 ----
PLAYER_INPUT_MAX_CHARS=200
COMPRESS_MODE=llm                         # llm | extractive | off
PERSONA_MODE=index                        # index 人物卡只放核心 + 索引、细节按话题注入 | full 全量进 system

# ---- GOD / tree / ENV 的模型部分（都只提议，代码校验后执行） ----
DIRECTOR_MODE=llm                         # 导演：llm | rules | off
DIRECTOR_MAX_ACTIONS=2
BRANCH_MODE=llm                           # 分支（自由说出的处置方案）：llm | rules | off
SCENE_MODE=llm                            # 场景（自由描述想看什么）：llm | rules | off
DIRECTOR_TEMPERATURE=0.3
DIRECTOR_MAX_TOKENS=400
BRANCH_TEMPERATURE=0.0
SCENE_TEMPERATURE=0.7
# MODEL_DIRECTOR=gemma-small               # 也可以路由到小模型
